model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Settings: data folder and as-of date
queryGroup 00_Parameters

/// Raw CRM extracts, loaded as-is (connection only)
queryGroup 0_RawData

/// Reusable M functions
queryGroup 0_Functions

/// Cleaning, business rules and reshaping (connection only)
queryGroup 1_StagingArea

/// Tables loaded into the model
queryGroup 2_DataModel

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table fct_opportunity
ref table fct_opportunity_line
ref table fct_pipeline_snapshot
ref table fct_sales_target
ref table fct_stage_history
ref table bridge_opportunity_plant
ref table dim_account
ref table dim_competitor
ref table dim_country
ref table dim_forecast_category
ref table dim_loss_reason
ref table dim_order_type
ref table dim_plant
ref table dim_product
ref table dim_sales_rep
ref table dim_stage
ref table dim_theater
ref table fct_data_quality_audit
ref table dim_date
ref table dim_product_type
ref table _Measures

ref cultureInfo en-US

