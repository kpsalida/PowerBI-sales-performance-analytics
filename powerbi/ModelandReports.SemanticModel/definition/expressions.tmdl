expression stg_Opportunity =
		let
		    Source = raw_Opportunity,
		
		    // ─── 1. TYPES ───────────────────────────────────────────────────────────────
		    #"Changed Type" = Table.TransformColumnTypes(Source, {
		        {"Id", type text}, {"Name", type text}, {"AccountId", type text}, {"OwnerId", type text},
		        {"Rep_Theater__c", type text}, {"QS_Order_Type__c", type text}, {"Product_Type__c", type text},
		        {"StageName", type text}, {"Sales_Forecast_Category__c", type text}, {"Primary_Competitor__c", type text},
		        {"Win_Loss_Reason__c", type text}, {"NextStep", type text}, {"Value_play__c", type text},
		        {"Plant_MWp__c", type number}, {"CloseDate", type date}, {"Estimated_COD__c", type date},
		        {"Material_Delivery_Date__c", type date}}, "en-US"),
		
		    // Salesforce timestamp (2025-10-31T12:03:15.000+0000) -> date
		    #"CreatedDate to Date" = Table.TransformColumns(#"Changed Type",
		        {{"CreatedDate", each Date.FromText(Text.Start(_, 10), [Format = "yyyy-MM-dd"]), type date}}),
		
		    // Empty text from the export -> null, so "missing" means one thing everywhere
		    #"Blanks to Null" = Table.ReplaceValue(#"CreatedDate to Date", "", null, Replacer.ReplaceValue,
		        {"Primary_Competitor__c", "Win_Loss_Reason__c", "NextStep", "Value_play__c"}),
		
		    // ─── 2. BUSINESS RULES: keep only real new-business opportunities ───────────
		    // 2a. Losses logged as duplicates of another opportunity (null-safe, case-insensitive)
		    #"Removed Duplicate Losses" = Table.SelectRows(#"Blanks to Null", each not (
		        [StageName] = "Closed Lost"
		        and Text.Lower(Text.Trim(if [Win_Loss_Reason__c] = null then "" else [Win_Loss_Reason__c])) = "duplicate")),
		
		    // 2b. Allowed order types, with the CRM code -> reporting name mapping in one place
		    OrderTypeMap = [
		        #"New" = "New Logo",
		        #"Cross Sell" = "Cross-sell",
		        #"Additional Products & Services (Upsell)" = "Upsell"
		    ],
		    #"Kept Sales Order Types" = Table.SelectRows(#"Removed Duplicate Losses",
		        each [QS_Order_Type__c] <> null and Record.HasFields(OrderTypeMap, [QS_Order_Type__c])),
		
		    // 2c. Renewals are recurring revenue, not new sales
		    #"Removed Renewals" = Table.SelectRows(#"Kept Sales Order Types",
		        each not Text.Contains([Name], "renewal", Comparer.OrdinalIgnoreCase)),
		
		    // 2d. Only opportunities on real accounts (test accounts are removed in stg_Account)
		    ValidAccounts = List.Buffer(stg_Account[AccountId]),
		    #"Kept Real Accounts" = Table.SelectRows(#"Removed Renewals", each List.Contains(ValidAccounts, [AccountId])),
		
		    // ─── 3. STANDARDISE CODES ───────────────────────────────────────────────────
		    #"Mapped Order Type" = Table.TransformColumns(#"Kept Real Accounts",
		        {{"QS_Order_Type__c", each Record.Field(OrderTypeMap, _), type text}}),
		    #"Mapped Theater" = Table.TransformColumns(#"Mapped Order Type",
		        {{"Rep_Theater__c", each if _ = "EMEA" or _ = "RoW" then "EMEA & RoW" else _, type text}}),
		
		    // ─── 4. DERIVED COLUMNS ─────────────────────────────────────────────────────
		    #"Added IsClosed" = Table.AddColumn(#"Mapped Theater", "IsClosed",
		        each if List.Contains({"Closed Won", "Closed Lost"}, [StageName]) then 1 else 0, Int64.Type),
		    #"Added IsWon" = Table.AddColumn(#"Added IsClosed", "IsWon", each if [StageName] = "Closed Won" then 1 else 0, Int64.Type),
		    // Age: created -> close for closed deals, created -> as-of date for open deals
		    #"Added AgeDays" = Table.AddColumn(#"Added IsWon", "AgeDays",
		        each Duration.Days((if [IsClosed] = 1 then [CloseDate] else AsOfDate) - [CreatedDate]), Int64.Type),
		
		    // ─── 5. MODEL NAMES AND COLUMN ORDER ────────────────────────────────────────
		    #"Renamed Columns" = Table.RenameColumns(#"Added AgeDays", {
		        {"Id", "OpportunityId"}, {"Name", "OpportunityName"}, {"Rep_Theater__c", "Theater"},
		        {"QS_Order_Type__c", "OrderType"}, {"Product_Type__c", "PrimaryProductType"},
		        {"Sales_Forecast_Category__c", "ForecastCategory"}, {"Primary_Competitor__c", "PrimaryCompetitorId"},
		        {"Win_Loss_Reason__c", "LossReason"}, {"Value_play__c", "ValuePlay"}, {"Plant_MWp__c", "PlantMWp"},
		        {"Estimated_COD__c", "EstimatedCOD"}, {"Material_Delivery_Date__c", "MaterialDeliveryDate"}}),
		    #"Selected Columns" = Table.SelectColumns(#"Renamed Columns", {
		        "OpportunityId", "OpportunityName", "AccountId", "OwnerId", "Theater", "OrderType", "PrimaryProductType",
		        "CreatedDate", "CloseDate", "StageName", "ForecastCategory", "IsClosed", "IsWon", "AgeDays",
		        "PrimaryCompetitorId", "LossReason", "NextStep", "ValuePlay", "PlantMWp", "EstimatedCOD", "MaterialDeliveryDate"})
		in
		    #"Selected Columns"
	lineageTag: 9b3bb473-b314-4078-aa48-e3b52cb3d621
	queryGroup: 1_StagingArea

expression stg_OpportunityLine =
		let
		    Source = raw_OpportunityLineItem,
		    #"Changed Type" = Table.TransformColumnTypes(Source, {
		        {"Id", type text}, {"OpportunityId", type text}, {"Product2Id", type text},
		        {"CurrencyIsoCode", type text}, {"QS_Annual_Recurring_Revenue__c", type number}}, "en-US"),
		
		    // 1. Keep lines of opportunities that passed staging, and take the close date from the header
		    OppHeader = Table.SelectColumns(stg_Opportunity, {"OpportunityId", "CloseDate"}),
		    #"Joined Header" = Table.NestedJoin(#"Changed Type", {"OpportunityId"}, OppHeader, {"OpportunityId"}, "Header", JoinKind.Inner),
		    #"Expanded CloseDate" = Table.ExpandTableColumn(#"Joined Header", "Header", {"CloseDate"}),
		
		    // 2. Product type from the product dimension
		    #"Joined Product" = Table.NestedJoin(#"Expanded CloseDate", {"Product2Id"}, dim_product, {"ProductId"}, "Product", JoinKind.LeftOuter),
		    #"Expanded ProductType" = Table.ExpandTableColumn(#"Joined Product", "Product", {"ProductType"}),
		
		    // 3. Local currency -> USD with the rate valid on the close date (FX table buffered once)
		    FxRates = Table.Buffer(stg_FxRates),
		    #"Added ARR_USD" = Table.AddColumn(#"Expanded ProductType", "ARR_USD",
		        each Number.Round(fnConvertToUSD([QS_Annual_Recurring_Revenue__c], [CurrencyIsoCode], [CloseDate], FxRates) / 100, 0, RoundingMode.AwayFromZero) * 100,
		        Int64.Type),
		
		    #"Renamed Columns" = Table.RenameColumns(#"Added ARR_USD", {{"Id", "OpportunityLineId"}, {"Product2Id", "ProductId"}}),
		    #"Selected Columns" = Table.SelectColumns(#"Renamed Columns", {"OpportunityLineId", "OpportunityId", "ProductId", "ProductType", "CloseDate", "ARR_USD"})
		in
		    #"Selected Columns"
	lineageTag: 6162671f-f8e4-48f7-9cb6-9cedf9ab72fc
	queryGroup: 1_StagingArea

expression stg_DataQualityAudit =
		// One audit flag per opportunity and required CRM field (1 = missing, 0 = filled),
		// unpivoted to a long table for the data-quality report.
		let
		    Source = stg_Opportunity,
		    OppsWithPlant = List.Buffer(List.Distinct(bridge_opportunity_plant[OpportunityId])),
		    IsMissing = (value as any) as number => if value = null or value = "" then 1 else 0,
		
		    // Flags. A flag is null where the rule does not apply; the unpivot below drops nulls.
		    // Prefix "Audit_" = General rules for every deal, "AuditSCADA_" = extra rules for SCADA deals.
		    #"Flag Next Step"          = Table.AddColumn(Source, "Audit_Next Step", each IsMissing([NextStep]), Int64.Type),
		    #"Flag Competitor"         = Table.AddColumn(#"Flag Next Step", "Audit_Primary Competitor", each IsMissing([PrimaryCompetitorId]), Int64.Type),
		    #"Flag Value Play"         = Table.AddColumn(#"Flag Competitor", "Audit_Value Play", each IsMissing([ValuePlay]), Int64.Type),
		    #"Flag Loss Reason"        = Table.AddColumn(#"Flag Value Play", "Audit_Loss Reason",
		                                    each if [StageName] = "Closed Lost" then IsMissing([LossReason]) else null, Int64.Type),
		    #"Flag Close Date in Past" = Table.AddColumn(#"Flag Loss Reason", "Audit_Close Date in Past",
		                                    each if [IsClosed] = 0 then (if [CloseDate] < AsOfDate then 1 else 0) else null, Int64.Type),
		    #"Flag Plant MWp"          = Table.AddColumn(#"Flag Close Date in Past", "AuditSCADA_Plant MWp",
		                                    each if [PrimaryProductType] = "SCADA" then IsMissing([PlantMWp]) else null, Int64.Type),
		    #"Flag Estimated COD"      = Table.AddColumn(#"Flag Plant MWp", "AuditSCADA_Estimated COD",
		                                    each if [PrimaryProductType] = "SCADA" then IsMissing([EstimatedCOD]) else null, Int64.Type),
		    #"Flag Delivery Date"      = Table.AddColumn(#"Flag Estimated COD", "AuditSCADA_Material Delivery Date",
		                                    each if [PrimaryProductType] = "SCADA" then IsMissing([MaterialDeliveryDate]) else null, Int64.Type),
		    #"Flag Account Plant"      = Table.AddColumn(#"Flag Delivery Date", "AuditSCADA_Account Plant",
		                                    each if [PrimaryProductType] = "SCADA" then (if List.Contains(OppsWithPlant, [OpportunityId]) then 0 else 1) else null, Int64.Type),
		
		    // Wide -> long
		    AuditColumns = List.Select(Table.ColumnNames(#"Flag Account Plant"), each Text.StartsWith(_, "Audit")),
		    #"Kept Audit Columns" = Table.SelectColumns(#"Flag Account Plant", {"OpportunityId", "IsClosed"} & AuditColumns),
		    #"Unpivoted Flags" = Table.UnpivotOtherColumns(#"Kept Audit Columns", {"OpportunityId", "IsClosed"}, "AuditField", "IsMissing"),
		
		    // Clean up names: group from the prefix, attribute from the text after "_"
		    #"Added AuditGroup" = Table.AddColumn(#"Unpivoted Flags", "AuditGroup",
		        each if Text.StartsWith([AuditField], "AuditSCADA_") then "SCADA" else "General", type text),
		    #"Added Attribute" = Table.AddColumn(#"Added AuditGroup", "Attribute", each Text.AfterDelimiter([AuditField], "_"), type text),
		    #"Added RecordStatus" = Table.AddColumn(#"Added Attribute", "RecordStatus", each if [IsClosed] = 1 then "Closed" else "Pipeline", type text),
		    #"Selected Columns" = Table.SelectColumns(#"Added RecordStatus", {"OpportunityId", "Attribute", "AuditGroup", "IsMissing", "RecordStatus"}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Selected Columns", {{"IsMissing", Int64.Type}})
		in
		    #"Changed Type"
	lineageTag: cb76d81d-e702-457d-b73b-2f42e4cb89fb
	queryGroup: 1_StagingArea

expression stg_SalesTargets =
		// Finance keeps targets as one row per segment and year, one column per quarter, in thousands of USD.
		let
		    Source = raw_SalesTargets,
		    #"Changed Type" = Table.TransformColumnTypes(Source, {
		        {"Segment", type text}, {"Year", Int64.Type}, {"Q1", type number}, {"Q2", type number},
		        {"Q3", type number}, {"Q4", type number}}, "en-US"),
		
		    // Wide -> long. Quarters without a target (empty cells) are dropped by the unpivot.
		    #"Unpivoted Quarters" = Table.UnpivotOtherColumns(#"Changed Type", {"Segment", "Year"}, "Quarter", "Target_kUSD"),
		
		    // "EMEA & RoW SaaS": theater = text before the LAST space, product type = text after it
		    #"Added Theater" = Table.AddColumn(#"Unpivoted Quarters", "Theater",
		        each Text.BeforeDelimiter([Segment], " ", {0, RelativePosition.FromEnd}), type text),
		    #"Added ProductType" = Table.AddColumn(#"Added Theater", "ProductType",
		        each Text.AfterDelimiter([Segment], " ", {0, RelativePosition.FromEnd}), type text),
		
		    // Quarter start date for the relationship to the calendar
		    #"Added QuarterStartDate" = Table.AddColumn(#"Added ProductType", "QuarterStartDate",
		        each #date([Year], (Number.From(Text.End([Quarter], 1)) - 1) * 3 + 1, 1), type date),
		    #"Added YearQuarter" = Table.AddColumn(#"Added QuarterStartDate", "YearQuarter", each Text.From([Year]) & " " & [Quarter], type text),
		
		    // kUSD -> USD
		    #"Added TargetUSD" = Table.AddColumn(#"Added YearQuarter", "TargetUSD", each Number.Round([Target_kUSD] * 1000), Int64.Type),
		    #"Selected Columns" = Table.SelectColumns(#"Added TargetUSD", {"QuarterStartDate", "YearQuarter", "Theater", "ProductType", "TargetUSD"})
		in
		    #"Selected Columns"
	lineageTag: 01955e81-2b3c-4845-8753-9457cf763b80
	queryGroup: 1_StagingArea

